{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "node_modules/.tsc",
    "emitDeclarationOnly": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "src",
    "vite.config.ts",
    "../studio/src/connection.ts",
    "../studio/src/i18n/*.ts",
    "../studio/src/rpc/*.ts",
    "../studio/src/store/*.ts",
    "../studio/src/test-helpers/*.ts"
  ],
  "exclude": ["../studio/src/**/*.test.ts"],
  "references": [
    {
      "path": "../../packages/kernel"
    },
    {
      "path": "../../packages/server"
    }
  ]
}
