# Copy to your shell profile, never commit real keys.
# Phase 6 moves keys into the OS keychain (see docs/adr/0006-secrets.md).
ANTHROPIC_API_KEY=
# Ollama endpoint (default http://127.0.0.1:11434)
OLLAMA_HOST=
# Where KernelPAI keeps its local journal (default ~/.kernelpai)
KPAI_HOME=
# Ask for confirmation when a single call is estimated above this amount (USD)
KPAI_CONFIRM_ABOVE_USD=0.10
